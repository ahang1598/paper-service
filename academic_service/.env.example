# ============================================================================
# paper-service 环境配置示例（密钥 + 环境覆盖）
# ----------------------------------------------------------------------------
# 复制为 .env 后按需修改。**生产环境严禁提交真实 .env**（.env 已被 .gitignore）。
#
# 配置分层（优先级低 → 高）：
#   configs/config.yaml (base) < configs/config.<APP_ENV>.yaml < .env < 真实环境变量
# 结构性默认（地址/端口/超时/设备信息等）集中在 configs/*.yaml；
# 本文件只放【密钥】与【环境选择/覆盖】。
# ============================================================================

# ---- 环境选择 ----
# prod（默认）= 加载 config.yaml + config.prod.yaml；dev = 叠加 config.dev.yaml（关闭鉴权）
# 也可用 APP_CONFIG_FILE=/abs/path/to.yaml 指定单个/多个（逗号分隔）文件，覆盖叠加逻辑
APP_ENV=prod

# ---- 对外鉴权 ----
# 生产必须为 true（base 配置已默认 true；此处可显式覆盖）
AUTH_ENABLED=true
# 允许的 Bearer token 集合（逗号分隔）。密钥：仅在此 / 环境变量注入，勿写进 YAML
API_BEARER_TOKENS=change-me-token-1,change-me-token-2

# ---- 下游文档全文服务 ----
# 地址/端口/scheme 已在 configs/config.yaml 给出；如需覆盖可在此设置
# DOC_SERVICE_SCHEME=http
# DOC_SERVICE_HOST=10.34.236.1
# DOC_SERVICE_PORT=9983
# HMAC 鉴权密钥（由服务方分配）。密钥：仅在此 / 环境变量注入
DOC_SERVICE_AUTH_KEY=replace-with-real-key

# ---- 下游 docid 搜索服务 ----
DOCID_SEARCH_AUTH_KEY=replace-with-real-key

# ---- relevant 论文检索 ----
# 外网 SiliconFlow 与内网 GTE 的密钥；实际使用哪一个由 RERANKER_PROVIDER 决定。
SILICONFLOW_API_KEY=
INTERNAL_RERANK_SIGN_KEY=
# 可选覆盖：最低相关度与按论文 chunk 数计算的动态 Top-K 比例
# RERANKER_MIN_SCORE=0.2
# RERANKER_TOP_K_MIN=5
# RERANKER_TOP_K_RATIO=0.1

# ---- 论文处理调试日志（默认关闭）----
# 开启后会打印全文、章节、chunk、reranker query/documents/scores；仅用于受控调试环境。
DEBUG_LOG_PAPER_PROCESSING=false

# ---- 默认设备信息（可选覆盖；默认值见 configs/config.yaml）----
# DEFAULT_DEVICE_APP_VERSION=12.1.8.410
# DEFAULT_DEVICE_ID=pmq
# DEFAULT_DEVICE_MODEL=ALN-AL00
# DEFAULT_DEVICE_TYPE=phone
# DEFAULT_DEVICE_PRD_PKG_NAME=com.huawei.vassistant
