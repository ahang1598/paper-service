# ============================================================================
# paper-service 配置示例
# 复制为 .env 后按需修改。生产环境严禁提交真实 .env。
# ============================================================================

# ---- 本服务监听 ----
SERVICE_HOST=0.0.0.0
SERVICE_PORT=12135
LOG_LEVEL=INFO

# ---- 对外鉴权 ----
# 是否开启 Bearer 鉴权（HTTP 与 WebSocket 共用）。
# 生产环境必须为 true；测试/本地调试可设为 false 以关闭鉴权。
AUTH_ENABLED=true
# 允许的 Bearer token 集合（逗号分隔）。关闭鉴权时此项可留空。
API_BEARER_TOKENS=change-me-token-1,change-me-token-2

# ---- 下游文档全文服务 ----
DOC_SERVICE_SCHEME=http
DOC_SERVICE_HOST=10.34.236.1
DOC_SERVICE_PORT=9983
# HMAC 鉴权密钥（由服务方分配）。请勿硬编码到代码库。
DOC_SERVICE_AUTH_KEY=xxxx

# ---- 默认设备信息（请求下游时使用，可在请求级覆盖）----
DEFAULT_DEVICE_APP_VERSION=12.1.8.410
DEFAULT_DEVICE_ID=pmq
DEFAULT_DEVICE_MODEL=ALN-AL00
DEFAULT_DEVICE_TYPE=phone
DEFAULT_DEVICE_PRD_PKG_NAME=com.huawei.vassistant
